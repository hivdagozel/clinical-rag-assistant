APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.1

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

USE_MEDICINE_API=false
MEDICINE_API_URL=http://localhost:3000
MEDICINE_API_TIMEOUT=10

KT_PDF_DIR=data/accepted_pdfs/kt
KUB_PDF_DIR=data/accepted_pdfs/kub
METADATA_FILE=data/metadata/documents.json
VECTORSTORE_DIR=data/vectorstore/medicines
QUARANTINE_DIR=data/quarantine
REJECTED_PDF_DIR=data/rejected_pdfs

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
FAISS_DISTANCE_THRESHOLD=1.3

# Yalnız test çalıştırıcısı tarafından true yapılmalıdır.
TEST_MODE=false
# TEST_VECTORSTORE_DIR=C:/tmp/medical-rag-test-index

# Kurumsal sertifika gerekiyorsa requests tarafından otomatik okunur.
# REQUESTS_CA_BUNDLE=C:/certificates/company-ca.pem
# SSL_CERT_FILE=C:/certificates/company-ca.pem
